AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false until a real privacy policy is published.
PRIVACY_INTAKE_ENABLED=false

