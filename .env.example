# demo | supabase
# Leave empty to use Supabase when the three keys below are all set, otherwise demo.
DATA_SOURCE=

# Public site URL used for sitemap and shared links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL. Placeholder only.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Safe to expose to the browser. Placeholder only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Demo sign-in overrides. Empty values use the on-screen demo accounts.
# Ignored when DATA_SOURCE=supabase.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_AGENT_EMAIL=
DEMO_AGENT_PASSWORD=
DEMO_SESSION_SECRET=

# Optional directory for local demo records. Defaults to .data
DEMO_DATA_DIR=
